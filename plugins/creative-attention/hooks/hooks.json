{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(mcp__.*|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|WebFetch)$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ca-guard\"", "timeout": 120 }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ca-render-check\"", "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ca-render-check\"", "timeout": 20 }
        ]
      }
    ]
  }
}
