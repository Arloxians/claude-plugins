#!/bin/sh
# Creative Attention policy guard (PreToolUse hook). Same logic as `ca-launch.exe guard`.
# Reads the hook JSON on stdin; denies image/video generation tools from other connectors.
# Note: \u JSON escapes are read literally here (Claude Code never escapes ASCII in hook JSON), unlike the Go guard.
# Fails closed: if ANY "tool_name" value anywhere in the input is a denied tool, deny.
LONG="luma pika recraft seedream seededit dreamina higgsfield replicate runway kling minimax hailuo ideogram midjourney leonardo stability eachlabs seedance heygen synthesia elevenlabs"
SHORT="fal falai veo sora krea flux imagen dalle comfy comfyui wan hunyuan ltx pixverse vidu hedra"
PHRASES="gpt image|dall e|nano banana|gemini image|image generate|images generate|generate image|generate images|text to image|text to video"

is_denied() {
  case "$1" in
    mcp__plugin_creative-attention_creative-attention__*) return 1 ;;
    mcp__*) ;;
    *) return 1 ;;
  esac
  lower=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  for w in $LONG; do
    case "$lower" in *"$w"*) return 0 ;; esac
  done
  tokens=$(printf '%s' "$lower" | tr -c 'a-z0-9' ' ')
  for t in $tokens; do
    base=$t
    prev=
    while [ "$base" != "$prev" ]; do
      prev=$base
      base=$(printf '%s' "$base" | sed 's/[0-9]*$//')
      for sfx in ai labs pro fast dev turbo max lite; do
        case "$base" in ?*"$sfx") base=${base%"$sfx"} ;; esac
      done
    done
    for w in $SHORT; do
      [ "$base" = "$w" ] && return 0
    done
  done
  norm=" $(printf '%s' "$tokens" | tr -s ' ') "
  oldifs=$IFS
  IFS='|'
  for p in $PHRASES; do
    case "$norm" in *" $p "*) IFS=$oldifs; return 0 ;; esac
  done
  IFS=$oldifs
  return 1
}

names=$(grep -o '"tool_name"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/^"tool_name"[[:space:]]*:[[:space:]]*"\(.*\)"$/\1/')
deny=0
set -f
oldifs=$IFS
IFS='
'
for n in $names; do
  IFS=$oldifs
  is_denied "$n" && deny=1
  IFS='
'
done
IFS=$oldifs
if [ "$deny" = 1 ]; then
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Company policy: image and video generation only goes through Creative Attention (eachlabs via the Arlox router). Use the creative-attention tools instead."}}'
fi
exit 0
