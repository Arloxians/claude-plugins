#!/bin/sh
# Creative Attention policy guard (PreToolUse hook). Same logic as `ca-launch.exe guard` (launcher/guard.go);
# both are tested against guard/cases.json. POSIX sh only (dash, bash 3.2, Git Bash): no bashisms.
#
# A per-teammate switch lives in the Arlox router (GET /auth/cli/me -> "creative_attention": true|false).
#   on      : image/audio/video generation only through Creative Attention; other generators are denied.
#   off     : anything goes except Creative Attention itself.
#   unknown : treated as on (fail closed).
# Decision:
#   1. names = every "tool_name" value in the input (nested ones too: fail closed).
#   2. Every name is a Creative Attention tool -> deny only when the switch is off.
#   3. Candidate = a non-CA tool name hit by a tool_* rule, or (only when a name is a scan tool: Bash,
#      PowerShell, Write, Edit, MultiEdit, NotebookEdit, WebFetch) a `text` rule found in the lowercased input
#      with the envelope, file_path and notebook_path fields removed. Not a candidate -> allow, no lookup.
#   4. Candidate -> look up the switch (cached): off -> allow, on -> deny, unknown -> deny.
# Rules come from guard/rules.txt next to bin/. CA_GUARD_RULES overrides that path only when CA_GUARD_TEST=1
# (tests). If the rules file is missing, unreadable or has no rules, the guard fails closed: every non-CA
# mcp__ tool and every scan-tool call is a candidate; CA tools still follow step 2.
# Always exits 0: Claude Code lets a call through when a hook fails, so denial is printed JSON only.
# Note: \u JSON escapes are read literally here (Claude Code never escapes ASCII in hook JSON), while the Go
# guard also decodes the top-level tool_name. Raw NUL bytes (never valid in JSON) are dropped or kept depending
# on the shell while Go keeps them, so the two guards may disagree on input that contains NUL.
LC_ALL=C
export LC_ALL
set -f

CA_PREFIX=mcp__plugin_creative-attention_creative-attention__
ON_REASON='Company policy: for you, image, audio and video generation only goes through Creative Attention (switched on by an Arlox admin). Use the creative-attention tools instead.'
UNKNOWN_SUFFIX=' (Your Creative Attention status could not be checked: you may not be signed in yet or the router is unreachable. Ask Claude to run ca_doctor to sign in.)'
OFF_REASON='Creative Attention is switched off for you. Ask an Arlox admin to switch it on.'
ENVELOPE='"(session_id|transcript_path|cwd|permission_mode|hook_event_name|tool_use_id|agent_id|agent_type|tool_name|file_path|notebook_path)"[[:space:]]*:[[:space:]]*"[^"]*"'
nl='
'
oifs=$IFS

deny() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$1"
  exit 0
}

# --- rules -------------------------------------------------------------------------------------------
rules=$(dirname "$0")/../guard/rules.txt
if [ "${CA_GUARD_TEST:-}" = 1 ] && [ -n "${CA_GUARD_RULES:-}" ]; then
  rules=$CA_GUARD_RULES
fi
LONG= SHORT= PHRASES= TEXTS=
nrules=0
if [ -r "$rules" ] && [ -f "$rules" ]; then
  rules_txt=$(tr -d '\r' < "$rules" 2>/dev/null) || rules_txt=
  while IFS= read -r line; do
    line=${line%"${line##*[! 	]}"}
    case $line in
      "tool_long "*) LONG=$LONG${line#tool_long }$nl ;;
      "tool_short "*) SHORT=$SHORT${line#tool_short }$nl ;;
      "tool_phrase "*) PHRASES=$PHRASES${line#tool_phrase }$nl ;;
      "text "*) TEXTS=$TEXTS${line#text }$nl ;;
      *) continue ;;
    esac
    nrules=$((nrules + 1))
  done <<EOF
$rules_txt
EOF
fi

# is_denied NAME: 0 when NAME is a non-CA MCP tool hit by a tool_* rule.
is_denied() {
  case $1 in
    "$CA_PREFIX"*) return 1 ;;
    mcp__*) ;;
    *) return 1 ;;
  esac
  lower=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  IFS=$nl
  for w in $LONG; do
    case $lower in *"$w"*) IFS=$oifs; return 0 ;; esac
  done
  IFS=$oifs
  tokens=$(printf '%s' "$lower" | tr -c 'a-z0-9' ' ')
  for t in $tokens; do
    base=$t
    prev=
    while [ "$base" != "$prev" ]; do
      prev=$base
      while :; do
        case $base in *[0-9]) base=${base%?} ;; *) break ;; esac
      done
      for sfx in ai labs pro fast dev turbo max lite; do
        case $base in ?*"$sfx") base=${base%"$sfx"} ;; esac
      done
    done
    IFS=$nl
    for w in $SHORT; do
      [ "$base" = "$w" ] && { IFS=$oifs; return 0; }
    done
    IFS=$oifs
  done
  norm=" $(printf '%s' "$tokens" | tr -s ' ') "
  IFS=$nl
  for p in $PHRASES; do
    case $norm in *" $p "*) IFS=$oifs; return 0 ;; esac
  done
  IFS=$oifs
  return 1
}

# --- switch lookup -----------------------------------------------------------------------------------
ca_home() {
  if [ -n "${CA_HOME:-}" ]; then
    printf '%s' "$CA_HOME"
    return
  fi
  if [ -n "${LOCALAPPDATA:-}" ]; then
    lad=$LOCALAPPDATA
    if command -v cygpath >/dev/null 2>&1; then
      lad=$(cygpath -u "$LOCALAPPDATA" 2>/dev/null) || lad=$LOCALAPPDATA
    fi
    if [ -d "$lad/creative-attention" ]; then
      printf '%s' "$lad/creative-attention"
      return
    fi
  fi
  printf '%s' "${HOME:-}/.creative-attention"
}

# fetch_status HOME: on | off | unknown, from the router. The token goes to curl on stdin, never argv.
fetch_status() {
  [ -r "$1/auth.json" ] || { echo unknown; return; }
  tok=$(tr -d '\r\n' < "$1/auth.json" 2>/dev/null | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\(arx_[A-Za-z0-9_-][A-Za-z0-9_-]*\)".*/\1/p')
  [ -n "$tok" ] || { echo unknown; return; }
  router=${ROUTER_URL:-https://router.arlox.io}
  while :; do
    case $router in */) router=${router%/} ;; *) break ;; esac
  done
  # https to any host; plain http only to localhost / 127.0.0.1 with an optional numeric port. No userinfo (@)
  # and no whitespace anywhere, so http://localhost:@evil.example cannot carry the token elsewhere.
  case $router in
    *@*|*[[:space:]]*) echo unknown; return ;;
    https://?*) ;;
    http://*)
      host=${router#http://}
      host=${host%%/*}
      case $host in
        localhost|127.0.0.1) ;;
        localhost:?*|127.0.0.1:?*)
          case ${host#*:} in *[!0-9]*) echo unknown; return ;; esac
          ;;
        *) echo unknown; return ;;
      esac
      ;;
    *) echo unknown; return ;;
  esac
  command -v curl >/dev/null 2>&1 || { echo unknown; return; }
  # -q first: ignore ~/.curlrc. Only HTTP 200 counts (a redirect body is never trusted).
  out=$(printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -q -fsS --max-time 3 -K - -w '\n%{http_code}' "$router/auth/cli/me" 2>/dev/null) || { echo unknown; return; }
  [ "${out##*"$nl"}" = 200 ] || { echo unknown; return; }
  body=${out%"$nl"*}
  if printf '%s\n' "$body" | grep -q '"creative_attention"[[:space:]]*:[[:space:]]*true'; then
    echo on
  elif printf '%s\n' "$body" | grep -q '"creative_attention"[[:space:]]*:[[:space:]]*false'; then
    echo off
  else
    echo unknown
  fi
}

# lookup: cached switch state. Cache file "<epoch> <state>": on/off live 120 s, unknown 20 s.
lookup() {
  home=$(ca_home)
  dir=${CLAUDE_PLUGIN_DATA:-$home}
  cache=$dir/policy-cache
  now=$(date +%s)
  if [ -f "$cache" ] && [ -r "$cache" ]; then
    ts= st=
    { read -r ts st || :; } < "$cache" 2>/dev/null
    case $ts in
      ''|*[!0-9]*|???????????????*) ;;
      *)
        age=$((now - ts))
        case $st in on|off) max=120 ;; unknown) max=20 ;; *) max=0 ;; esac
        if [ "$age" -ge 0 ] && [ "$age" -lt "$max" ]; then
          printf '%s' "$st"
          return
        fi
        ;;
    esac
  fi
  st=$(fetch_status "$home")
  if mkdir -p "$dir" 2>/dev/null; then
    tmp=$dir/policy-cache.$$.tmp
    if printf '%s %s\n' "$now" "$st" > "$tmp" 2>/dev/null; then
      mv -f "$tmp" "$cache" 2>/dev/null || rm -f "$tmp" 2>/dev/null
    else
      rm -f "$tmp" 2>/dev/null
    fi
  fi
  printf '%s' "$st"
}

# --- decision ----------------------------------------------------------------------------------------
input=$(cat)
names=$(printf '%s\n' "$input" | tr '\r\n' '  ' | grep -o '"tool_name"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/^"tool_name"[[:space:]]*:[[:space:]]*"\(.*\)"$/\1/')

all_ca=0
if [ -n "$names" ]; then
  all_ca=1
  IFS=$nl
  for n in $names; do
    case $n in "$CA_PREFIX"*) ;; *) all_ca=0 ;; esac
  done
  IFS=$oifs
fi
if [ "$all_ca" = 1 ]; then
  [ "$(lookup)" = off ] && deny "$OFF_REASON"
  exit 0
fi

# Text scan only for tools that run commands, write files or fetch URLs.
scan=0
IFS=$nl
for n in $names; do
  case $n in Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|WebFetch) scan=1 ;; esac
done
IFS=$oifs

cand=0
if [ "$nrules" -gt 0 ]; then
  IFS=$nl
  for n in $names; do
    IFS=$oifs
    is_denied "$n" && { cand=1; break; }
    IFS=$nl
  done
  IFS=$oifs
  if [ "$cand" = 0 ] && [ "$scan" = 1 ]; then
    set --
    IFS=$nl
    for p in $TEXTS; do
      set -- "$@" -e "$p"
    done
    IFS=$oifs
    if [ $# -gt 0 ] && printf '%s\n' "$input" | tr 'A-Z' 'a-z' | sed -E "s/$ENVELOPE//g" | grep -qF "$@"; then
      cand=1
    fi
  fi
else
  IFS=$nl
  for n in $names; do
    case $n in "$CA_PREFIX"*) ;; mcp__*) cand=1 ;; esac
  done
  IFS=$oifs
  [ "$scan" = 1 ] && cand=1
fi
[ "$cand" = 1 ] || exit 0

case $(lookup) in
  off) exit 0 ;;
  on) deny "$ON_REASON" ;;
  *) deny "$ON_REASON$UNKNOWN_SUFFIX" ;;
esac
exit 0
