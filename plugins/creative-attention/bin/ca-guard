#!/bin/sh
# Creative Attention policy guard (PreToolUse hook). Same logic as `ca-launch.exe guard` (launcher/guard.go);
# both are tested against guard/cases.json. POSIX sh only (dash, bash 3.2, Git Bash): no bashisms.
#
# A per-teammate switch lives in the Arlox router (GET /auth/cli/me -> "creative_attention": true|false).
#   on      : image/audio/video generation only through Creative Attention; other generators are denied.
#   off     : anything goes except Creative Attention itself.
#   unknown : treated as on (fail closed).
# Decision:
#   1. names = every "tool_name" value in the input (nested ones too: fail closed).
#   2. Every name is a Creative Attention tool -> deny only when the switch is off.
#   3. Candidate = a non-CA tool name hit by a tool_* rule (tokens taken as is and with camelCase split), or
#      (only when a name is a scan tool) a `text` rule found in the lowercased input with the envelope,
#      file_path and notebook_path fields removed. Scan tools: Bash, PowerShell, Write, Edit, MultiEdit,
#      NotebookEdit, WebFetch, and non-CA MCP tools whose last name segment (camelCase split, lowercased,
#      - as _) contains execute_code, execute_command, run_command, start_process, run_code, write_file,
#      edit_file or create_file. More than 200 tool_name values -> candidate without further analysis.
#      Not a candidate -> allow, no router lookup.
#   4. Candidate -> look up the switch: off -> allow, on -> deny, unknown -> deny. Only "on" and "unknown"
#      are cached ("off" is never cached or trusted from the cache, so a forged cache cannot switch it off).
# Rules come from guard/rules.txt next to bin/. CA_GUARD_RULES overrides that path only when CA_GUARD_TEST=1
# (tests). If the rules file is missing, unreadable or has no rules, the guard fails closed: every non-CA
# mcp__ tool and every scan-tool call is a candidate; CA tools still follow step 2.
# Always exits 0: Claude Code lets a call through when a hook fails, so denial is printed JSON only.
# Accepted limits (same class as removing or editing the plugin itself, which the user can always do):
# CA_GUARD_TEST=1 with CA_GUARD_RULES, ROUTER_URL pointing at a local or attacker-run server, and a curl
# shadowed earlier on PATH.
# Note: \u JSON escapes are read literally here (Claude Code never escapes ASCII in hook JSON), while the Go
# guard also decodes the top-level tool_name. Raw NUL bytes (never valid in JSON) are dropped or kept depending
# on the shell while Go keeps them, so the two guards may disagree on input that contains NUL.
LC_ALL=C
export LC_ALL
set -f

CA_PREFIX=mcp__plugin_creative-attention_creative-attention__
ON_REASON='Company policy: for you, image, audio and video generation only goes through Creative Attention (switched on by an Arlox admin). Use the creative-attention tools instead.'
UNKNOWN_SUFFIX=' (Your Creative Attention status could not be checked: you may not be signed in yet or the router is unreachable. Ask Claude to run ca_doctor to sign in.)'
OFF_REASON='Creative Attention is switched off for you. Ask an Arlox admin to switch it on.'
nl='
'
oifs=$IFS

deny() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$1"
  exit 0
}

# --- rules -------------------------------------------------------------------------------------------
rules=$(dirname "$0")/../guard/rules.txt
if [ "${CA_GUARD_TEST:-}" = 1 ] && [ -n "${CA_GUARD_RULES:-}" ]; then
  rules=$CA_GUARD_RULES
fi
# Here: count the rules and collect the text rules. The tool_* rules are read again by the awk pass below.
TEXTS=
nrules=0
if [ -r "$rules" ] && [ -f "$rules" ]; then
  rules_txt=$(tr -d '\r' < "$rules" 2>/dev/null) || rules_txt=
  while IFS= read -r line; do
    line=${line%"${line##*[! 	]}"}
    case $line in
      "tool_long "*|"tool_short "*|"tool_phrase "*) ;;
      "text "*) TEXTS=$TEXTS${line#text }$nl ;;
      *) continue ;;
    esac
    nrules=$((nrules + 1))
  done <<EOF
$rules_txt
EOF
fi

# Text scan: rules file first (text rules), then the hook input on stdin. Per line: ASCII-lowercase, drop the
# envelope / file_path / notebook_path string fields, then look for each text rule as a plain substring.
# (awk index() instead of grep -F: BSD grep -F with ~150 patterns takes seconds on a large Write.)
TEXT_AWK='
NR == FNR {
  gsub(/\r/, "")
  sub(/[ \t]+$/, "")
  if (index($0, "text ") == 1) P[++np] = substr($0, 6)
  next
}
{
  l = tolower($0)
  gsub(/"(session_id|transcript_path|cwd|permission_mode|hook_event_name|tool_use_id|agent_id|agent_type|tool_name|file_path|notebook_path)"[ \t\v\f\r]*:[ \t\v\f\r]*"[^"]*"/, "", l)
  for (i = 1; i <= np; i++) if (index(l, P[i])) { hit = 1; exit }
}
END { print hit + 0 }'

# One awk pass over all names (GUARD_NAMES, newline-separated) with the tool_* rules read from the rules file.
# Prints "<all_ca> <scan> <denied>" as 0/1 flags. Mirrors guardDecide/toolDenied/scanTool in launcher/guard.go.
NAMES_AWK='
function camel(s,   o, i, c, p) {
  o = ""; p = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c ~ /[A-Z]/ && p ~ /[a-z0-9]/) o = o "_"
    o = o c; p = c
  }
  return o
}
function strip(t,   prev, k, x) {
  prev = ""
  while (t != prev) {
    prev = t
    sub(/[0-9]+$/, "", t)
    for (k = 1; k <= 8; k++) {
      x = SFX[k]
      if (length(t) > length(x) && substr(t, length(t) - length(x) + 1) == x) t = substr(t, 1, length(t) - length(x))
    }
  }
  return t
}
function toks(l,   n, a, i, j, norm) {
  gsub(/[^a-z0-9]+/, " ", l)
  n = split(l, a, " ")
  norm = " "
  for (i = 1; i <= n; i++) {
    if (strip(a[i]) in SHORT) return 1
    norm = norm a[i] " "
  }
  for (j = 1; j <= np; j++) if (index(norm, " " PH[j] " ")) return 1
  return 0
}
function denied(n,   lower, i) {
  if (index(n, CAP) == 1 || index(n, "mcp__") != 1) return 0
  lower = tolower(n)
  for (i = 1; i <= nlong; i++) if (index(lower, LONG[i])) return 1
  return toks(lower) || toks(tolower(camel(n)))
}
function scantool(n,   seg, i) {
  if (n in SCANSET) return 1
  if (index(n, CAP) == 1 || index(n, "mcp__") != 1) return 0
  seg = n
  sub(/.*__/, "", seg)
  seg = tolower(camel(seg))
  gsub(/-/, "_", seg)
  for (i = 1; i <= nscan; i++) if (index(seg, SCANSEG[i])) return 1
  return 0
}
BEGIN {
  CAP = "mcp__plugin_creative-attention_creative-attention__"
  split("ai labs pro fast dev turbo max lite", SFX, " ")
  nscan = split("execute_code execute_command run_command start_process run_code write_file edit_file create_file", SCANSEG, " ")
  SCANSET["Bash"]; SCANSET["PowerShell"]; SCANSET["Write"]; SCANSET["Edit"]; SCANSET["MultiEdit"]
  SCANSET["NotebookEdit"]; SCANSET["WebFetch"]
}
{
  gsub(/\r/, "")
  sub(/[ \t]+$/, "")
  if (index($0, "tool_long ") == 1) LONG[++nlong] = substr($0, 11)
  else if (index($0, "tool_short ") == 1) SHORT[substr($0, 12)]
  else if (index($0, "tool_phrase ") == 1) PH[++np] = substr($0, 13)
}
END {
  nn = split(ENVIRON["GUARD_NAMES"], N, "\n")
  allca = 0; scan = 0; den = 0; seen = 0
  for (i = 1; i <= nn; i++) {
    if (N[i] == "") continue
    if (!seen) { allca = 1; seen = 1 }
    if (index(N[i], CAP) != 1) allca = 0
    if (scantool(N[i])) scan = 1
    if (!den && denied(N[i])) den = 1
  }
  print allca, scan, den
}'

# --- switch lookup -----------------------------------------------------------------------------------
ca_home() {
  if [ -n "${CA_HOME:-}" ]; then
    printf '%s' "$CA_HOME"
    return
  fi
  if [ -n "${LOCALAPPDATA:-}" ]; then
    lad=$LOCALAPPDATA
    if command -v cygpath >/dev/null 2>&1; then
      lad=$(cygpath -u "$LOCALAPPDATA" 2>/dev/null) || lad=$LOCALAPPDATA
    fi
    if [ -d "$lad/creative-attention" ]; then
      printf '%s' "$lad/creative-attention"
      return
    fi
  fi
  printf '%s' "${HOME:-}/.creative-attention"
}

# fetch_status HOME: on | off | unknown, from the router. The token goes to curl on stdin, never argv.
fetch_status() {
  [ -r "$1/auth.json" ] || { echo unknown; return; }
  tok=$(tr -d '\r\n' < "$1/auth.json" 2>/dev/null | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\(arx_[A-Za-z0-9_-][A-Za-z0-9_-]*\)".*/\1/p')
  [ -n "$tok" ] || { echo unknown; return; }
  router=${ROUTER_URL:-https://router.arlox.io}
  while :; do
    case $router in */) router=${router%/} ;; *) break ;; esac
  done
  # https to any host; plain http only to localhost / 127.0.0.1 with an optional numeric port. No userinfo (@)
  # and no whitespace anywhere, so http://localhost:@evil.example cannot carry the token elsewhere.
  case $router in
    *@*|*[[:space:]]*) echo unknown; return ;;
    https://?*) ;;
    http://*)
      host=${router#http://}
      host=${host%%/*}
      case $host in
        localhost|127.0.0.1) ;;
        localhost:?*|127.0.0.1:?*)
          case ${host#*:} in *[!0-9]*) echo unknown; return ;; esac
          ;;
        *) echo unknown; return ;;
      esac
      ;;
    *) echo unknown; return ;;
  esac
  command -v curl >/dev/null 2>&1 || { echo unknown; return; }
  # -q first: ignore ~/.curlrc. Only HTTP 200 counts (a redirect body is never trusted).
  out=$(printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -q -fsS --max-time 3 -K - -w '\n%{http_code}' "$router/auth/cli/me" 2>/dev/null) || { echo unknown; return; }
  [ "${out##*"$nl"}" = 200 ] || { echo unknown; return; }
  body=${out%"$nl"*}
  if printf '%s\n' "$body" | grep -q '"creative_attention"[[:space:]]*:[[:space:]]*true'; then
    echo on
  elif printf '%s\n' "$body" | grep -q '"creative_attention"[[:space:]]*:[[:space:]]*false'; then
    echo off
  else
    echo unknown
  fi
}

# lookup: switch state. Cache file "<epoch> <state>": on lives 120 s, unknown 20 s; off is never cached.
lookup() {
  home=$(ca_home)
  dir=${CLAUDE_PLUGIN_DATA:-$home}
  cache=$dir/policy-cache
  now=$(date +%s)
  # Strict format: ^[1-9][0-9]{0,11} (on|unknown)$ (one line). Anything else counts as no cache.
  if [ -f "$cache" ] && [ -r "$cache" ]; then
    line=
    { IFS= read -r line || :; } < "$cache" 2>/dev/null
    ts=${line%% *}
    st=${line#* }
    case $ts in
      ''|0*|*[!0-9]*|?????????????*) ;;
      *)
        max=0
        case $st in on) max=120 ;; unknown) max=20 ;; esac
        age=$((now - ts))
        if [ "$age" -ge 0 ] && [ "$age" -lt "$max" ]; then
          printf '%s' "$st"
          return
        fi
        ;;
    esac
  fi
  st=$(fetch_status "$home")
  if [ "$st" != off ] && mkdir -p "$dir" 2>/dev/null; then
    tmp=$dir/policy-cache.$$.tmp
    if printf '%s %s\n' "$now" "$st" > "$tmp" 2>/dev/null; then
      mv -f "$tmp" "$cache" 2>/dev/null || rm -f "$tmp" 2>/dev/null
    else
      rm -f "$tmp" 2>/dev/null
    fi
  fi
  printf '%s' "$st"
}

# --- decision ----------------------------------------------------------------------------------------
input=$(cat)
# Non-empty tool_name values (CR/LF joined first). At most 201 are kept: more than 200 is a candidate without
# further analysis (fail closed, bounded work).
names=$(printf '%s\n' "$input" | tr '\r\n' '  ' | grep -o '"tool_name"[[:space:]]*:[[:space:]]*"[^"][^"]*"' | head -n 201 | sed 's/^"tool_name"[[:space:]]*:[[:space:]]*"\(.*\)"$/\1/')
count=0
IFS=$nl
for n in $names; do
  count=$((count + 1))
done
IFS=$oifs

if [ "$count" -gt 200 ]; then
  cand=1
else
  rfile=$rules
  [ "$nrules" -gt 0 ] || rfile=/dev/null
  flags=$(GUARD_NAMES=$names awk "$NAMES_AWK" "$rfile" 2>/dev/null)
  case $flags in
    [01]" "[01]" "[01]) ;;
    *) flags="0 1 1" ;; # awk failed: fail closed
  esac
  all_ca=${flags%% *}
  scan=${flags#* }
  scan=${scan%% *}
  denied=${flags##* }
  if [ "$all_ca" = 1 ]; then
    [ "$(lookup)" = off ] && deny "$OFF_REASON"
    exit 0
  fi
  cand=0
  if [ "$nrules" -gt 0 ]; then
    cand=$denied
    if [ "$cand" = 0 ] && [ "$scan" = 1 ] && [ -n "$TEXTS" ]; then
      hit=$(printf '%s\n' "$input" | awk "$TEXT_AWK" "$rules" - 2>/dev/null)
      case $hit in 0) ;; *) cand=1 ;; esac # 1, or awk failed: fail closed
    fi
  else
    # No rules: fail closed. Every non-CA mcp__ tool and every scan-tool call is a candidate.
    IFS=$nl
    for n in $names; do
      case $n in "$CA_PREFIX"*) ;; mcp__*) cand=1 ;; esac
    done
    IFS=$oifs
    [ "$scan" = 1 ] && cand=1
  fi
fi
[ "$cand" = 1 ] || exit 0

case $(lookup) in
  off) exit 0 ;;
  on) deny "$ON_REASON" ;;
  *) deny "$ON_REASON$UNKNOWN_SUFFIX" ;;
esac
exit 0
